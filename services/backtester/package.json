{
  "name": "@grokpulse/backtester",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cli": "node dist/cli.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@grokpulse/types": "workspace:*",
    "@grokpulse/feature-engine": "workspace:*",
    "@grokpulse/signal-engine": "workspace:*",
    "@grokpulse/risk": "workspace:*",
    "@grokpulse/database": "workspace:*",
    "@grokpulse/config": "workspace:*",
    "@grokpulse/logging": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
