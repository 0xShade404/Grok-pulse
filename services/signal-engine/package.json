    "@grokpulse/config": "workspace:*",
    "@grokpulse/logging": "workspace:*",
    "ioredis": "^5.11.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/ioredis-mock": "^8.2.8",
    "ioredis-mock": "^8.13.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
