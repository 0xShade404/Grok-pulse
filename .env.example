# ==============================================================================
# GrokPulse environment configuration
#
# Copy to .env and fill in real values for local development.
# NEVER commit a real .env file. This file must only ever contain placeholders.
# ==============================================================================

# --- Application ---------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
LOG_LEVEL=info

# --- Database (PostgreSQL + TimescaleDB) ----------------------------------
DATABASE_URL=postgres://grokpulse:grokpulse@localhost:5432/grokpulse

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Authentication ----------------------------------------------------------
AUTH_SECRET=replace-with-a-long-random-string

# --- xAI (Grok) --------------------------------------------------------------
XAI_API_KEY=
XAI_MODEL=grok-4

# --- Polymarket --------------------------------------------------------------
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137

# --- Wallet (legacy/unused) ---------------------------------------------------
# GrokPulse's live-trading architecture is non-custodial: each user links and
# signs with their OWN browser wallet (see apps/api's /api/wallet/link/*
# routes and apps/web's wallet-connect UI) -- there is no single
# server-level wallet these two variables would configure. They are kept in
# the schema for backwards compatibility with the original spec but are not
# read anywhere in the real code path; safe to leave blank.
WALLET_PROVIDER=
WALLET_ADDRESS=

# --- Live-order funding check (required to enable live trading) --------------
# Non-custodial live orders (CLAUDE.md section 19 "account funded" check)
# read the user's linked wallet's on-chain USDC balance directly -- there is
# no server-tracked balance to fall back on. Both variables below MUST be set
# for live trading to ever be possible; if either is empty, every live order
# fails closed with ACCOUNT_NOT_FUNDED (see apps/api/src/lib/funding-checker.ts).
#
# POLYGON_RPC_URL: any Polygon PoS mainnet JSON-RPC endpoint you control or
# trust (e.g. from Alchemy, Infura, or a self-hosted node).
#
# POLYGON_USDC_ADDRESS: the USDC contract address Polymarket actually
# settles in. This has changed over Polymarket's history (bridged USDC.e vs.
# native USDC) and must be verified against current Polymarket/Polygon
# documentation before going live -- do not copy a value from memory or an
# outdated source.
POLYGON_RPC_URL=
POLYGON_USDC_ADDRESS=

# --- apps/web (browser-exposed; NEXT_PUBLIC_* only, never a secret) ----------
# REST API base URL the terminal calls.
NEXT_PUBLIC_API_URL=http://localhost:4000
# "mock" | "live" -- selects apps/web's fixture-vs-real-API path for the
# Phase 1 market/portfolio/etc. mock data pattern (lib/api/client.ts). Does
# NOT gate auth/wallet/live-order calls, which always call the real API
# regardless of this flag (see lib/api/auth.ts).
NEXT_PUBLIC_DATA_SOURCE=mock
# Polymarket's public CLOB REST host, called directly from the browser only
# to read public, non-authenticated market metadata (tick size, fee rate,
# neg-risk flag) while building/signing a live order client-side with
# @polymarket/clob-client's createOrder(). No secret ever goes over this
# call -- it never carries POLYMARKET_API_KEY/SECRET/PASSPHRASE, those stay
# server-side only. Defaults to the same value as POLYMARKET_CLOB_HOST above.
NEXT_PUBLIC_POLYMARKET_CLOB_HOST=https://clob.polymarket.com
# Optional: only set this to a real project id from https://cloud.reown.com
# (WalletConnect Cloud) to additionally enable the WalletConnect connector.
# Left unset, wallet connection is injected-only (MetaMask etc.), which is a
# complete non-custodial flow on its own -- no fabricated id belongs here.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Underlying crypto market data -------------------------------------------
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# --- Observability -------------------------------------------------------------
SENTRY_DSN=
PROMETHEUS_PORT=9464

# --- Feature flags -------------------------------------------------------------
# Live trading must NEVER default to true. It requires explicit, deliberate
# operator opt-in after the live-trading definition-of-done (spec section 83)
# has been satisfied.
ENABLE_LIVE_TRADING=false
ENABLE_PAPER_TRADING=true
ENABLE_GROK=true
ENABLE_BACKTESTING=true
ENABLE_BTC=true
ENABLE_ETH=true
ENABLE_AUTO_EXECUTION=false
ENABLE_MOBILE_TRADING=false

# --- Data source guard ---------------------------------------------------------
# "mock" | "live" -- must be explicit, never silently falls back.
DATA_SOURCE=mock
