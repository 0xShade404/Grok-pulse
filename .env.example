# ==============================================================================
# GrokPulse environment configuration
#
# Copy to .env and fill in real values for local development.
# NEVER commit a real .env file. This file must only ever contain placeholders.
# ==============================================================================

# --- Application ---------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
LOG_LEVEL=info

# --- Database (PostgreSQL + TimescaleDB) ----------------------------------
DATABASE_URL=postgres://grokpulse:grokpulse@localhost:5432/grokpulse

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Authentication ----------------------------------------------------------
AUTH_SECRET=replace-with-a-long-random-string

# --- xAI (Grok) --------------------------------------------------------------
XAI_API_KEY=
XAI_MODEL=grok-4

# --- Polymarket --------------------------------------------------------------
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137

# --- Wallet (only required for live trading) ---------------------------------
WALLET_PROVIDER=
WALLET_ADDRESS=

# --- Underlying crypto market data -------------------------------------------
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# --- Observability -------------------------------------------------------------
SENTRY_DSN=
PROMETHEUS_PORT=9464

# --- Feature flags -------------------------------------------------------------
# Live trading must NEVER default to true. It requires explicit, deliberate
# operator opt-in after the live-trading definition-of-done (spec section 83)
# has been satisfied.
ENABLE_LIVE_TRADING=false
ENABLE_PAPER_TRADING=true
ENABLE_GROK=true
ENABLE_BACKTESTING=true
ENABLE_BTC=true
ENABLE_ETH=true
ENABLE_AUTO_EXECUTION=false
ENABLE_MOBILE_TRADING=false

# --- Data source guard ---------------------------------------------------------
# "mock" | "live" -- must be explicit, never silently falls back.
DATA_SOURCE=mock
