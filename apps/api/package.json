{
  "name": "@grokpulse/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.0",
    "@grokpulse/config": "workspace:*",
    "@grokpulse/database": "workspace:*",
    "@grokpulse/feature-engine": "workspace:*",
    "@grokpulse/grok-agent": "workspace:*",
    "@grokpulse/logging": "workspace:*",
    "@grokpulse/polymarket": "workspace:*",
    "@grokpulse/redis": "workspace:*",
    "@grokpulse/risk": "workspace:*",
    "@grokpulse/signal-engine": "workspace:*",
    "@grokpulse/trading-engine": "workspace:*",
    "@grokpulse/types": "workspace:*",
    "@grokpulse/xai": "workspace:*",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^4.0.2",
    "jose": "^6.2.10",
    "prom-client": "^15.1.3",
    "viem": "^2.21.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@polymarket/clob-client": "^5.8.1",
    "@types/ioredis-mock": "^8.2.8",
    "@types/ws": "^8.5.13",
    "ioredis-mock": "^8.13.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
